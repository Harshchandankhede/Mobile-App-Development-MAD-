<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FFFDF1"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Implicit Intents"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#562F00"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnSms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send Message!!!"
        android:backgroundTint="#FF9644"
        android:textColor="#FFFDF1"
        android:textSize="18sp"
        android:layout_marginBottom="15dp"/>

    <Button
        android:id="@+id/btnCall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Call Anuj"
        android:backgroundTint="#FFCE99"
        android:textColor="#562F00"
        android:textSize="18sp"
        android:layout_marginBottom="15dp"/>

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Settings"
        android:backgroundTint="#FF9644"
        android:textColor="#FFFDF1"
        android:textSize="18sp"
        android:layout_marginBottom="15dp"/>

    <Button
        android:id="@+id/btnNetwork"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Network Details"
        android:backgroundTint="#FFCE99"
        android:textColor="#562F00"
        android:textSize="18sp"/>
</LinearLayout>