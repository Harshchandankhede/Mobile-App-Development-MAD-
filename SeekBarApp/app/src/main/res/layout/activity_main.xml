<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <ToggleButton android:id="@+id/toggleBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:onClick="onToggleClick" />
    <TextView android:id="@+id/tvToggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Toggle is OFF" android:layout_marginBottom="20dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choose Language:" />
    <Spinner android:id="@+id/spinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp"/>

    <Button android:id="@+id/btnAlert" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Alert Dialog" android:layout_marginBottom="20dp"/>

    <RatingBar android:id="@+id/ratingBar" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <Button android:id="@+id/btnRating" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Submit Rating (Shows Toast)" android:layout_marginBottom="20dp"/>

    <Button android:id="@+id/btnProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Progress Dialog" />

</LinearLayout>